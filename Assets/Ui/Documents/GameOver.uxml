<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui/Styles/GameOver.uss?fileID=7433441132597879392&amp;guid=3b81c213fd784fe44b982e72a032e860&amp;type=3#GameOver" />
    <ui:VisualElement name="root" class="root" style="flex-grow: 1;">
        <ui:VisualElement name="frame" class="frame border-radius" style="flex-grow: 1; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;">
            <ui:Label text="Game Over&#10;" class="title" />
            <ui:Label text="Your shadow caught you... Watch an ad and increase your reward!" class="description" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-right: 40px; padding-left: 40px; padding-bottom: 40px;" />
            <ui:VisualElement class="frame-button" style="flex-grow: 0;">
                <ui:Button class="button" style="justify-content: center; align-content: center; background-color: rgb(246, 193, 101);">
                    <ui:Label text="NO THANKS" class="button-text" style="padding-right: 30px; padding-left: 30px;" />
                </ui:Button>
                <ui:Button class="button" style="margin-left: 25px; margin-top: 0; margin-right: 0; margin-bottom: 0; padding-right: 0; background-color: rgb(166, 187, 240); justify-content: center; flex-direction: row;">
                    <ui:VisualElement style="flex-grow: initial; position: relative; background-image: url(&quot;project://database/Assets/Art/Textures/Ui/TXT_AdIcon.png?fileID=2800000&amp;guid=4fb2cd5dd3968eb4090869a592ac39ba&amp;type=3#TXT_AdIcon&quot;); width: 24%; height: 44%; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(40, 40, 40);" />
                    <ui:Label text="yes" class="button-text" style="width: 47%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 53%; font-size: 64px; -unity-text-align: upper-center; flex-grow: 0; align-content: center;" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

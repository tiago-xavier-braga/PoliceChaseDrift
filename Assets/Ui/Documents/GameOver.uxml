<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui/Styles/GameOver.uss?fileID=7433441132597879392&amp;guid=3b81c213fd784fe44b982e72a032e860&amp;type=3#GameOver" />
    <ui:VisualElement name="root" class="root" style="flex-grow: 1;">
        <ui:VisualElement name="frame" class="frame border-radius" style="flex-grow: 1; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; background-color: rgb(40, 40, 40);">
            <ui:Label text="Game Over&#10;" class="title" style="font-size: 80%;" />
            <ui:Label text="Your shadow caught you... Watch an ad and increase your reward!" class="description" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-right: 40px; padding-left: 40px; padding-bottom: 40px; font-size: 36%;" />
            <ui:VisualElement class="frame-button">
                <ui:Button class="button" style="justify-content: center; align-content: center; background-color: rgba(246, 193, 101, 0); flex-grow: 0;">
                    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-color: rgb(246, 193, 101);" />
                    <ui:Label text="NO THANKS" class="button-text" style="padding-right: 30px; padding-left: 30px; width: 80%;" />
                </ui:Button>
                <ui:Button name="Button" enabled="true" class="button button-green" style="justify-content: center; align-content: center; flex-grow: 0; -unity-slice-left: 0; -unity-slice-type: tiled; background-color: rgba(33, 209, 159, 0);">
                    <ui:VisualElement class="button-green" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;" />
                    <ui:VisualElement style="flex-grow: initial; position: relative; background-image: url(&quot;project://database/Assets/Art/Textures/Ui/TXT_WarehouseIcon.png?fileID=2800000&amp;guid=dd77c8511705f6142bd4237287fd702b&amp;type=3#TXT_WarehouseIcon&quot;); width: 21%; height: 40%; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(40, 40, 40); -unity-background-scale-mode: stretch-to-fill;" />
                    <ui:Label text="GARAGE" class="button-text" style="padding-right: 0; padding-left: 0; padding-top: 5px; padding-bottom: 0; flex-grow: 0; width: 60%; -unity-text-align: middle-left; height: 53%; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 14px;" />
                </ui:Button>
                <ui:Button class="button" style="background-color: rgba(166, 187, 240, 0); justify-content: center; flex-direction: row; flex-grow: 0;">
                    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-color: rgb(166, 187, 240);" />
                    <ui:VisualElement style="flex-grow: initial; position: relative; background-image: url(&quot;project://database/Assets/Art/Textures/Ui/TXT_AdIcon.png?fileID=2800000&amp;guid=4fb2cd5dd3968eb4090869a592ac39ba&amp;type=3#TXT_AdIcon&quot;); width: 21%; height: 40%; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(40, 40, 40); -unity-background-scale-mode: stretch-to-fill;" />
                    <ui:Label text="LET’S GO!" class="button-text" style="width: 60%; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 14px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 53%; flex-grow: 0; align-content: center; -unity-text-align: middle-left;" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
